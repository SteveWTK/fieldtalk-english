        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|tone|size|sting|shieldColor|title|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: mark, tone, size, sting, shieldColor, title, style."
